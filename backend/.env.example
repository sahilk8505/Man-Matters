# =============================================================================
# Man Matters Creative OS — Backend Environment Variables
# Copy to .env and fill in values
# =============================================================================

# Server
SECRET_KEY=your-secret-key-min-32-chars-generate-with-openssl-rand-hex-32
DEBUG=true
ALLOWED_ORIGINS=["http://localhost:3001","https://your-domain.vercel.app"]
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/man_matters_cos

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=man-matters-creatives

# Google AI (Gemini + Embeddings)
GOOGLE_API_KEY=AIzaSyD28tfp8CKk4JC5K4T8djR3c4A9MOscEiM
GEMINI_MODEL=gemini-2.5-pro
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# Meta Marketing API
# Accounts confirmed 2026-06-04 — business: ManMatters2025 (3767985453466438)
# MM25 = act_920799776816968 (main account)
# Nutrition25 = act_2080540322400218 (nutrition/fitness)
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_ACCESS_TOKEN=your-long-lived-access-token
META_AD_ACCOUNT_ID=act_920799776816968
